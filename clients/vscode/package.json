{
  "name": "erf-thin-client",
  "displayName": "ERF Thin Client",
  "description": "Digest-only Finding 导航/解释/反馈草稿/例外申请的 IDE 薄客户端；不复制 Runtime/Factory/Server/Gate 权威。",
  "version": "0.1.0",
  "publisher": "ruleops",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "erf.showFinding",
        "title": "ERF: 展示 Finding",
        "category": "ERF",
        "icon": "$(inspect)"
      },
      {
        "command": "erf.navigateToLocation",
        "title": "ERF: 导航到位置",
        "category": "ERF",
        "icon": "$(go-to-file)"
      },
      {
        "command": "erf.explainFinding",
        "title": "ERF: 解释 Finding",
        "category": "ERF",
        "icon": "$(inspect)"
      },
      {
        "command": "erf.draftFeedback",
        "title": "ERF: 起草反馈（PROPOSED）",
        "category": "ERF",
        "icon": "$(edit)"
      },
      {
        "command": "erf.requestException",
        "title": "ERF: 申请例外（REQUESTED）",
        "category": "ERF",
        "icon": "$(edit)"
      },
      {
        "command": "erf.submitFeedback",
        "title": "ERF: 提交反馈到 Server（RECEIVED_ONLY）",
        "category": "ERF",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "erf.submitException",
        "title": "ERF: 提交例外到 Server（RECEIVED_ONLY）",
        "category": "ERF",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "erf.submissionStatus",
        "title": "ERF: 查询提交状态",
        "category": "ERF",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "erf.refresh",
        "title": "刷新上下文",
        "icon": "$(refresh)",
        "category": "ERF"
      },
      {
        "command": "erf.cancel",
        "title": "取消运行",
        "icon": "$(debug-stop)",
        "category": "ERF"
      },
      {
        "command": "erf.settings",
        "title": "打开 ERF 设置",
        "icon": "$(settings-gear)",
        "category": "ERF"
      },
      {
        "command": "erf.scan",
        "title": "ERF: 扫描结果工作台",
        "icon": "$(search)",
        "category": "ERF"
      },
      {
        "command": "erf.registryList",
        "title": "ERF: 浏览规则库（元数据）",
        "icon": "$(package)",
        "category": "ERF"
      },
      {
        "command": "erf.registryShow",
        "title": "ERF: 核对独立发布 pin",
        "icon": "$(package)",
        "category": "ERF"
      },
      {
        "command": "erf.registrySync",
        "title": "ERF: 缓存签名规则包",
        "icon": "$(package)",
        "category": "ERF"
      },
      {
        "command": "erf.doctor",
        "title": "ERF: 环境诊断",
        "icon": "$(tools)",
        "category": "ERF"
      },
      {
        "command": "erf.configValidate",
        "title": "ERF: 校验工作区配置",
        "icon": "$(tools)",
        "category": "ERF"
      },
      {
        "command": "erf.configShow",
        "title": "ERF: 查看有效配置",
        "icon": "$(tools)",
        "category": "ERF"
      },
      {
        "command": "erf.standardValidate",
        "title": "ERF: 校验标准文件",
        "icon": "$(checklist)",
        "category": "ERF"
      },
      {
        "command": "erf.ruleValidate",
        "title": "ERF: 校验规则文件",
        "icon": "$(checklist)",
        "category": "ERF"
      }
    ],
    "configuration": {
      "title": "ERF Thin Client",
      "properties": {
        "erf.rfPath": {
          "type": "string",
          "default": "rf",
          "description": "rf 启动器的路径；插件仅通过 rf 复用 Runner/Thin Client seam，不复制任何 Runtime 逻辑。"
        },
        "erf.serverEndpoint": {
          "type": "string",
          "default": "",
          "description": "可选的 RuleOps Server endpoint（如 https://host:port）。为空时禁用提交动作；不自动发现。"
        },
        "erf.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "是否允许 telemetry；默认关闭，隐私优先。"
        },
        "erf.requestTimeoutMs": {
          "type": "number",
          "default": 5000,
          "description": "HTTP 提交/状态查询/Registry 请求超时（毫秒）；本地扫描、诊断与校验进程缺省 600 秒，扫描可由 deadlineMs 覆盖。"
        },
        "erf.connectionProfile": {
          "type": "string",
          "default": "",
          "description": "Registry 显式连接 profile FILE 路径（不是 JSON/凭据内容）。非空时优先于 serverEndpoint；IDE 不读取或保存 token，CLI 解析文件与安全引用，失败不回退。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "erf",
          "title": "ERF",
          "icon": "resources/erf.svg"
        }
      ]
    },
    "views": {
      "erf": [
        {
          "id": "erf.scenarios",
          "name": "任务"
        },
        {
          "id": "erf.details",
          "name": "场景与运行状态",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "erf.refresh",
          "when": "view == erf.scenarios",
          "group": "navigation"
        },
        {
          "command": "erf.settings",
          "when": "view == erf.scenarios",
          "group": "navigation"
        },
        {
          "command": "erf.cancel",
          "when": "view == erf.scenarios && erf.running",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/prepare-resources.js",
    "test": "node scripts/prepare-resources.js && node --test test/*.test.js"
  }
}
